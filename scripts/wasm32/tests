#!/bin/bash
set -e
CARGO_ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "--relaxed" ]]; then
        export RELAXED_WARNINGS=1
    else
        CARGO_ARGS+=("$arg")
    fi
done
source "$(dirname "$0")/_env"

# The released wasm_lite CLI is the Cargo runner named in `.cargo/config.toml`.
if ! command -v wasm_lite >/dev/null 2>&1; then
    echo "wasm_lite runner not installed" >&2
    echo "install it with: cargo install wasm_lite_cli" >&2
    exit 1
fi

# Headless Firefox has no WebGPU. Chrome needs the explicit GPU switch to use
# SwiftShader instead of starting with --disable-gpu.
export WASM_LITE_BROWSER="${WASM_LITE_BROWSER:-chrome}"
export WASM_LITE_GPU="${WASM_LITE_GPU:-1}"

CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER="wasm_lite run" \
    RUSTFLAGS="$WASM32_RUSTFLAGS" \
    RUSTDOCFLAGS="$WASM32_RUSTDOCFLAGS" \
    cargo +nightly test \
        --target=wasm32-unknown-unknown --lib --tests --examples "${CARGO_ARGS[@]}"
